app.MapGet("/clientes", () =>
{
    var lista = new List<object>();

    for (int i = 0; i < totalClientes; i++)
    {
        var c = clientes[i];

        lista.Add(new
        {
            nome = c.GetNome(),
            idade = c.GetIdade(),
            email = c.GetEmail(),
            cidade = c.GetCidade()
        });
    }

    return Results.Ok(lista);
});